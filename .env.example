# Groq API key for Llama 3 70B (required from Phase 2 onward)
GROQ_API_KEY=

# LLM model identifier (Groq model name)
LLM_MODEL=llama3-70b-8192

# Groq OpenAI-compatible API base URL
LLM_BASE_URL=https://api.groq.com/openai/v1

# Low temperature (0.2–0.4) for consistent restaurant ranking
LLM_TEMPERATURE=0.3

# Max restaurants sent to LLM after filtering
MAX_CANDIDATES=20
